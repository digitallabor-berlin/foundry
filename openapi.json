":"string"},"length":{"type":"integer","minimum":0}}},"VerificationResult":{"type":"object","required":["verified","checks","claims"],"properties":{"checks":{"type":"array","items":{"$ref":"#/components/schemas/CheckResult"}},"claims":{},"verified":{"type":"boolean"}}},"VerificationState":{"type":"string","enum":["pending","verified","failed"]},"VerificationTransaction":{"type":"object","required":["id","state","nonce","dcql_query","transport","response_mode","ephem_private_jwk","ephem_public_jwk","created_at"],"properties":{"created_at":{"type":"integer","format":"int64"},"dcql_query":{},"ephem_private_jwk":{},"ephem_public_jwk":{},"id":{"type":"string"},"nonce":{"type":"string"},"response_mode":{"type":"string"},"result":{"allOf":[{"$ref":"#/components/schemas/VerificationResult"}],"nullable":true},"state":{"$ref":"#/components/schemas/VerificationState"},"transaction_data":{"type":"array","items":{"type":"string"},"description":"`transaction_data` entries **already base64url-encoded** per OpenID4VP\nv1.0 §8.4, exactly as advertised to the wallet. Stored encoded so that a\n`transaction_data_hashes` check hashes the same bytes that were sent.","nullable":true},"transport":{"type":"string"}}}}}}